piplinesdk/oms_multimodal/bbox/data/*.caffemodel.part
piplinesdk/oms_multimodal/bbox/data/*_googlenet.onnx
piplinesdk/oms_multimodal/bbox/data/*_googlenet.onnx.part

# Pipeline runtime DB
pipeline/data/*.db

# HMI runtime
hmi/data/hmi_local/
hmi/data/hmi_runtime/**
!hmi/data/hmi_runtime/README.md
hmi/data/*.db
hmi/data/models/
hmi/frontend/node_modules/
hmi/frontend/dist/

# Pipeline clip parse outputs (keep rosbag)
pipeline/clips/**/parsed_data/**/images/**
pipeline/clips/**/parsed_data/**/audio/audio.wav

