# Copy to .env and fill in values
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

# Model backend: api (DashScope, 本机默认) | mc (MaxCompute MaxFrame AI，需 pip install '.[mc]')
MODEL_BACKEND=api
# STORAGE_BACKEND=local

# Optional model overrides
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=1024
OMNI_MODEL=qwen3.5-omni-plus
ASR_MODEL=qwen3-asr-flash

# Acoustic panel rendering (for VL-embedding audio features)
ACOUSTIC_PANEL_TYPE=mel
ACOUSTIC_PANEL_N_FFT=2048
ACOUSTIC_PANEL_HOP_LENGTH=512
ACOUSTIC_PANEL_N_MELS=128
ACOUSTIC_PANEL_FMIN=20
# Leave empty to use Nyquist frequency
ACOUSTIC_PANEL_FMAX=
ACOUSTIC_PANEL_WIDTH=768
ACOUSTIC_PANEL_HEIGHT=256

# ASR (clip audio → text for labeling + embedding)
ASR_ENABLED=true
ASR_MODEL=qwen3-asr-flash
ASR_AUDIO_FORMAT=wav
ASR_LANGUAGE=zh
ASR_ENABLE_ITN=false

# Clip preview MP4 (sampled frames + WAV, local ffmpeg or imageio-ffmpeg)
CLIP_VIDEO_ENABLED=true
CLIP_VIDEO_FILENAME=clip_preview.mp4
CLIP_VIDEO_MAX_WIDTH=1280
CLIP_VIDEO_MAX_HEIGHT=720
CLIP_VIDEO_CODEC=libx264
CLIP_VIDEO_AUDIO_CODEC=aac
CLIP_VIDEO_CRF=23
# true: 每路 image topic 各生成一个 MP4（clip_preview_camera0.mp4 ...）
CLIP_VIDEO_ENCODE_ALL_CAMERAS=true
# 仅当 ENCODE_ALL_CAMERAS=false 时生效，指定单路 topic
CLIP_VIDEO_CAMERA_TOPIC=
