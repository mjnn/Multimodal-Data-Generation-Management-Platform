# DataWorks · sdk_pipeline_driver · 混合全链参数（P0）
# 节点代码：粘贴 pipeline/dataworks/bundled/sdk_pipeline_driver_node.py（整文件）
# 生成：py -3 pipeline/scripts/bundle_sdk_pipeline_driver.py
#
# 架构：
#   DPE apply_chunk = extract,preview（SDK 0.3.2，无嵌套 MaxFrame AI）
#   Driver 裸调 MaxFrame AI = asr,label,embed（Job2 同款）
#   Driver + DPE mount 写回 = asr.jsonl / labels.jsonl / fusion_embeddings.jsonl /
#     run.json（commit 标记；混合路径默认不含 upload stage）/ dispatch
#   Driver o = mc_write（内存 label/embed 行 → aig_sdk__*；dim_clip.active_run_id upsert）
#
# ⚠ 粘贴后第 1 行必须是：from __future__ import annotations
#
# 工作流「参数」面板：参数名 / 参数值分两格填写（不要写 key=value 同一格）

# --- 必填 ---
oss_bucket=rosbag-labels-pipeline-bucket2
oss_ram_role_arn=acs:ram::1413495213520409:role/maxframe-rosbag-oss
dpe_image=rosbag_sdk_dpe
cloud_region=cn_shanghai
mount_path=/mnt/oss
ds=20260807

# --- 全链：DPE extract+preview + Driver ASR/label/embed + mc_write + dispatch ---
# run.json 由 Driver 在 AI 产物写回后写出（无需 stages 含 upload；可选加 upload 双写）
stages=extract,preview,asr,label,embed,mc_write,dispatch
ai_submitter=driver
cleanup_work=false
model_backend=mc
batch_rows=1
dpe_parallel=4
max_bags=4
force_rerun=true
mc_modelset_project=bigdata_public_modelset
inference_quota_name=ai_InferenceQuota
asr_parallel_partitions=1
label_parallel_partitions=1
embed_parallel_partitions=1
asr_model=qwen3-asr-flash
omni_model=qwen3.5-omni-plus
embedding_model=qwen3-vl-embedding
embedding_dimension=1024

# --- 显式单 bag（推荐探针；跳过扫描）---
# bag_oss_key=rosbags/2026-06-05_13-27-07/output.bag
# clip_id=sha256:3cd012197d1f2112f51c7414500bb9770a143d1bbd1e1a2aaa84d9eccb51fc7b
# run_id=

# --- 资源 ---
dpe_cpu=4
dpe_memory_gb=16
sdk_table_prefix=aig_sdk__
session_max_alive_sec=14400
session_max_idle_sec=14400
odps_function_timeout_sec=3600

# --- 成功判据 ---
# 1) STAGES_SPLIT udf=['extract','preview'] driver_ai=['asr','embed','label'] driver=['dispatch','mc_write']
# 2) DPE_EXTRACT_PARALLEL partitions=4 bags=4 batch_rows=1
# 3) BATCH_SUMMARY_JSON ok_count=4（extract+preview）+ preview_ok=true
# 4) DRIVER_ASR_BATCH_JSON ok_count=4 audio_mode=oss_url（需 oss_vl_* AK）
# 5) DRIVER_LABEL_EMBED_MEDIA_MODE=oss_url + PACK_CLIP ... media_mode=oss_url
# 6) DRIVER_LABEL_PACK ... media_mode=oss_url（无 multi-MB Tunnel 风暴）
# 7) DRIVER_LABEL_BATCH_JSON ok_count=4 + DRIVER_EMBED_BATCH_JSON ok_count=4
# 8) MC_WRITE_OK + DISPATCH_JSON
# 9) OSS: .../asr.jsonl, labels.jsonl, fusion_embeddings.jsonl, clip_videos.jsonl
# 10) OSS: pipeline/dispatch/latest.json（或 dispatch_oss_key）
#
# 仅 ASR 探针时可改：stages=extract,asr
#
# --- OSS URL 媒体模式（ASR / label / embed 共用；免 DPE base64 过 Tunnel）---
# ai_media_mode=auto          # auto|oss_url|base64；有 oss_vl_* 时 auto→oss_url
# oss_vl_access_key_id=...
# oss_vl_access_key_secret=...
# 无 AK 时 fallback：audio_mode=dpe_base64、media_mode=dpe_base64（日志可见）
