# 复制为 .env 并填写真实值（勿提交 Git）
# 本目录演示默认 MODEL_BACKEND=mc（MaxCompute MaxFrame AI Function），非 DashScope API。
# 可与仓库根 .env 合并：根目录已有 ODPS_* / OSS_* 时可只填下面「联调专用」项。

# =============================================================================
# 后端选择（云端演示必填 mc）
# =============================================================================
MODEL_BACKEND=mc

# =============================================================================
# MaxCompute / ODPS（本机 PyODPS 联调；DataWorks 节点内可用 Driver 的 `o` 代替）
# =============================================================================
ODPS_PROJECT=rogbag_label_pipline
ODPS_ACCESS_ID=
ODPS_ACCESS_KEY=
ODPS_ENDPOINT=https://service.cn-shanghai.maxcompute.aliyun.com/api

# =============================================================================
# OSS（media_mode=oss 时 MC 读帧/音频 URL；与 shared/config.yaml 保持一致）
# =============================================================================
OSS_BUCKET=rosbag-labels-pipeline-bucket2
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
CLOUD_REGION=cn_shanghai
# Driver 写 manifest / VL 读 OSS URL 用（非 DPE 挂载）
OSS_VL_ACCESS_KEY_ID=
OSS_VL_ACCESS_KEY_SECRET=

# DPE 挂载 OSS（上云 DataWorks 必填；本机 notebook 仅 local 模式可暂空）
OSS_RAM_ROLE_ARN=
DPE_IMAGE=

# =============================================================================
# MC AI Function / modelset（与 DataWorks job2_asr / job3 / job4 对齐）
# =============================================================================
MC_MODELSET_PROJECT=bigdata_public_modelset
MC_CLOUD_REGION=cn_shanghai
MC_OSS_BUCKET=
MC_DPE_IMAGE=
MC_IMAGE_MODE=base64
# 本地 MEDIA_MODE=local 时用 base64；上云 OSS 媒体用 auto 或 oss_url
# MC_IMAGE_MODE=auto
# Omni 未上架 modelset 时留空 → SDK 使用 catalog 中的 OMNI_MODEL
MC_OMNI_FALLBACK_MODEL=
MC_AI_CU_QUOTA_NAME=
MC_AI_GU_QUOTA_NAME=
MC_TOTAL_RPM_LIMIT=
MC_REQUEST_TIMEOUT_SEC=
MC_AI_MEMORY=
MC_PARALLEL_PARTITIONS=1
# MaxFrame 2.8+：Omni = cp.video + cp.audio + cp.text（含 Job2 ASR 全文）
MC_OMNI_NATIVE_MEDIA=true

# =============================================================================
# 模型名（MC modelset catalog）
# =============================================================================
ASR_MODEL=qwen3-asr-flash
OMNI_MODEL=qwen3.5-omni-plus
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=1024
ASR_ENABLED=true
ASR_LANGUAGE=zh

# =============================================================================
# 联调路径（与 run_pipeline.py / sdk_*_node.py 同参）
# =============================================================================
BAG_LOCAL_PATH=D:\cursor_project\rosbag_to_labels_pipline\rosbag\output.bag
RUN_OUT_DIR=output/run_demo
CLIP_ID=sha256:demo
RUN_ID=local-demo-001
MEDIA_MODE=local
TAXONOMY_PATH=

# =============================================================================
# 本地 extract：声学面板 + Mel 矩阵 + 预览 MP4
# =============================================================================
ACOUSTIC_PANEL_TYPE=mel
ACOUSTIC_PANEL_N_MELS=128
ACOUSTIC_EXPORT_MEL_MATRIX=true
ACOUSTIC_MEL_MATRIX_CSV=true
CLIP_VIDEO_ENABLED=true
CLIP_VIDEO_ENCODE_ALL_CAMERAS=true
# extract 默认不再内联编码 MP4；旧行为：EXTRACT_INLINE_ENCODE=true
EXTRACT_INLINE_ENCODE=false
# bbox / 双视频编码（encode 节点或 infer_full）
BBOX_ENABLED=false
# 检测后端：noop | stub | opencv（Haar）| yolo（需 pip install oms-multimodal-sdk[bbox]）
# face / haar 仍可作为 opencv 的别名
BBOX_DETECTOR=noop
# 通用「元素」名（写入 boxes[].element；默认 element，可按业务改为 person/face/vehicle…）
BBOX_ELEMENT=element
# opencv 调参（可选；BBOX_FACE_* 仍兼容）
# BBOX_OPENCV_CASCADE=haarcascade_frontalface_default.xml
# BBOX_OPENCV_SCALE_FACTOR=1.1
# BBOX_OPENCV_MIN_NEIGHBORS=5
# BBOX_OPENCV_MIN_SIZE=30
# yolo 调参（可选；类别名会写入 element）
# BBOX_YOLO_MODEL=yolov8n.pt
# BBOX_YOLO_CONF=0.25
# BBOX_YOLO_CLASSES=0
ENCODE_PLAIN=true
ENCODE_BBOX=false
# Omni 选片：plain | bbox | auto（auto=有 bbox 视频优先）
OMNI_VIDEO_VARIANT=auto

# =============================================================================
# 标签树粒度（enum_tree）与输出形态
# =============================================================================
# 全局最大深度：0=不裁剪；1=仅顶层；2=含雨→大中小雨 等二级
LABEL_TAXONOMY_DEPTH=0
# 按维度覆盖，例：L1.3=2,L1.1=1 或 JSON {"L1.3":2}
# LABEL_TAXONOMY_DEPTH_BY_DIM=L1.3=2
# leaf | path（默认）| ancestors
LABEL_TREE_OUTPUT=path

# =============================================================================
# 可选：仅当 MODEL_BACKEND=api 时才需要（本演示默认不用）
# =============================================================================
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=cn-beijing
