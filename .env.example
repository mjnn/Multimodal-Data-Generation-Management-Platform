# Copy to .env and fill in real values. Never commit .env.
# 鏀?AK/SK 鍚庡悓姝ユ湰鍦?CLI锛歱ython scripts/sync_cloud_cli_config.py
# 鎿嶄綔鎵嬪唽锛歞ocs/cloud-cli-runbook.md

# HMI 数据源：local = SQLite + 本地 oss/ 目录；cloud = MaxCompute + OSS
HMI_DATA_SOURCE=local
# 测试模式：1=显示本地/云端切换与「重置测试数据」；0/空=强制云端、隐藏切换与重置
# HMI_TEST_MODE=0
# 本地运行时根目录（默认 hmi/data/hmi_runtime；ECS 可设为挂载盘路径）
# HMI_RUNTIME_ROOT=D:\data\hmi_runtime

# SDK：local 写入 HMI_RUNTIME oss 镜像；cloud 上传到 OSS_BUCKET
# STORAGE_BACKEND=local
# MODEL_BACKEND=mc          # local_sdk_mc_test / DataWorks：MaxFrame AI Function（默认 api 仅 HMI local worker）
# MC_MODELSET_PROJECT=bigdata_public_modelset

# ECS：OSS 自动同步由 HMI「OSS 管理」页开关控制（默认关闭）；以下为轮询间隔等参数
# HMI_OSS_SYNC_POLL_INTERVAL_SEC=30
# HMI_OSS_SYNC_AUTO_LOCAL=1
# HMI_OSS_SYNC_TIMEOUT_SEC=7200

# MaxCompute / ODPS锛堝繀濉紝鐢ㄤ簬 scripts/apply_mc_ddl.py 涓庡悗缁?MaxFrame Job锛?
ODPS_PROJECT=rogbag_label_pipline
ODPS_ACCESS_ID=
ODPS_ACCESS_KEY=
ODPS_ENDPOINT=https://service.cn-shanghai.maxcompute.aliyun.com/api

# OSS锛圝ob0/Job1 涓婁簯鏃跺繀濉紱涓?config.yaml cloud.oss.bucket 浜岄€変竴锛?
OSS_BUCKET=rosbag-labels-pipeline-bucket2
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# 鍖哄煙 shorthand锛屼笌涓婇潰 endpoint 淇濇寔涓€鑷存椂鍙渷鐣?endpoint 瑕嗙洊
CLOUD_REGION=cn_shanghai

# Job1 鑷畾涔?DPE锛圥4锛?
# ACR 瀹屾暣闀滃儚鍦板潃锛屼緥濡?registry.cn-shanghai.aliyuncs.com/<namespace>/rosbag-job1-dpe:latest
DPE_IMAGE=
# MaxCompute 璁块棶 OSS 鐨?RAM 瑙掕壊 ARN锛坵ith_fs_mount 鐢級
OSS_RAM_ROLE_ARN=

# HMI JWT auth (required for M1+; use a long random string in production)
HMI_JWT_SECRET=

# DataWorks OpenAPI：HMI 在线模式「上传并触发云端管线」
# DATAWORKS_PROJECT_NAME=your_workspace_en_identifier
# DATAWORKS_TRIGGER_MODE=smoke
#   smoke=CreateDagTest（周期节点如 p0）；manual=RunManualDagNodes；auto=有 FLOW 先 manual
# DATAWORKS_FLOW_NAME=
# DATAWORKS_NODE_ID=1234567890
#   ↑ 必须是数字节点 ID（DataWorks 节点属性里的「节点 ID」），不能写 p0 / 节点名
# DATAWORKS_PROJECT_ENV=PROD
# DATAWORKS_REGION_ID=cn-shanghai
# 可选：覆盖默认参数文件路径；或追加 key=value（空格分隔，勿含密钥到 git）
# DATAWORKS_DEFAULT_PARAMS=
# DATAWORKS_EXTRA_PARAMS=ai_media_mode=oss_url
# 注意：.env 行尾不要写中文注释粘在值上；或确保注释前有空格+#

# 孤儿 bag 兜底轮询（在线）：扫描 OSS 上已上传但未触发 DataWorks 的 .bag
# HMI_CLOUD_BAG_POLL_ENABLED=1
# HMI_CLOUD_BAG_POLL_INTERVAL_SEC=60
# HMI_CLOUD_BAG_POLL_MIN_AGE_SEC=180
# HMI_CLOUD_BAG_POLL_MAX_BAGS=4
# HMI_CLOUD_BAG_POLL_PREFIXES=rosbags/

# 阿里云 ACR（docker login / push；填 .env，勿提交）
# ACR_REGISTRY=crpi-02k3y8iudey5q0vb.cn-shanghai.personal.cr.aliyuncs.com
# ACR_USERNAME=
# ACR_PASSWORD=

# 阿里云企业 RAM 子账号（控制台 / CLI；填 .env，勿提交）
# ALIYUN_RAM_USERNAME=
# ALIYUN_RAM_PASSWORD=
