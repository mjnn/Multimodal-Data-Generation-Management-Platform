# Copy to /srv/apps/rosbag-to-labels-hmi/.env.runtime and fill secrets.
# Do NOT commit real credentials.

SERVICE_NAME=rosbag-to-labels-hmi
IMAGE=crpi-02k3y8iudey5q0vb.cn-shanghai.personal.cr.aliyuncs.com/mirror_ns/rosbag_to_labels_pipline_hmi:latest
HOST_PORT=8012
CONTAINER_PORT=8000

HMI_DATA_SOURCE=local
HMI_PUBLIC_API_BASE=/tools/rosbag-labels/api
HMI_JWT_SECRET=
HMI_RUNTIME_ROOT=/app/data/hmi_runtime
HMI_LOCAL_SDK_POLL_ENABLED=1
HMI_LOCAL_SDK_POLL_INTERVAL_SEC=20
# Optional: overrides UI「SDK 并发 clip 数」when set (1–8)
# HMI_LOCAL_SDK_PARALLEL=1
HMI_MIRROR_ARTIFACTS_TO_OSS=0
HMI_OSS_SYNC_POLL_ENABLED=0
HMI_OSS_SYNC_POLL_INTERVAL_SEC=30
HMI_OSS_SYNC_AUTO_LOCAL=1

ODPS_PROJECT=rogbag_label_pipline
ODPS_ACCESS_ID=
ODPS_ACCESS_KEY=
ODPS_ENDPOINT=https://service.cn-shanghai.maxcompute.aliyun.com/api

OSS_BUCKET=rosbag-labels-pipeline-bucket2
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
CLOUD_REGION=cn_shanghai

CORS_ORIGINS=http://47.116.180.173,http://localhost:5173

# Local SDK worker (rosbag upload → OMS Multimodal on ECS disk)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
